{
  "name": "Duralade",
  "scopeName": "source.duralade",
  "fileTypes": [
    "dl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.duralade",
          "match": "#\\s.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.duralade",
          "match": "\\b(entity|data|func|type|extern|native)\\b"
        },
        {
          "name": "storage.modifier.duralade",
          "match": "out!"
        },
        {
          "name": "storage.modifier.duralade",
          "match": "\\b(out|in|inout|intype|value|implicit|view|noblock)\\b"
        },
        {
          "name": "keyword.control.duralade",
          "match": "\\b(if|else|for|wait|defer|return|break|continue|implicitly)\\b"
        },
        {
          "name": "keyword.other.duralade",
          "match": "\\b(import|as|var|init|run|outer)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.duralade",
          "match": "[a-z_][a-z0-9_]*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.duralade",
          "match": "\\b(int|float|str|bool|any)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.backtick.duralade",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.duralade",
              "match": "``"
            }
          ]
        },
        {
          "name": "string.quoted.double.duralade",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.duralade",
              "match": "\\\\(?:[nrt\\\\\"\"]|x[0-9a-f]{2}|u[0-9a-f]{4}|U[0-9a-f]{8})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.duralade",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.duralade",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.duralade",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||\\?\\.|\\?\\?|->|\\.|\\?|!|@|&)"
        },
        {
          "name": "keyword.operator.assignment.duralade",
          "match": "(=|:=|\\+=|-=|\\*=|/=|%=)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "constant.language.boolean.duralade",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.duralade",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.other.raw.duralade",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "match": "``"
            }
          ]
        },
        {
          "name": "variable.other.duralade",
          "match": "\\b[a-z_][a-z0-9_]*\\b"
        }
      ]
    }
  }
}
