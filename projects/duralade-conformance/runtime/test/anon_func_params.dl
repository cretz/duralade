import duralade.assert
import duralade.test

func call_twice_in {
    in a: int
    in b: int
    in cb: func {
        in v: int
        out result: int
    }
    out sum = cb(v = a).result + cb(v = b).result
}

func call_twice_out {
    in cb: func {
        out v: int
    }
    in seed: int
    out final = cb(v = seed).v
}

@test
func captured_anon_func_param {
    out! :error?

    delta := 10
    adder := func {
        in v: int
        out result = v + delta
    }
    r1 := call_twice_in(cb = adder, a = 1, b = 2)
    assert::equal(actual = r1.sum, expected = 23)!

    delta = 20
    r2 := call_twice_in(cb = adder, a = 1, b = 2)
    assert::equal(actual = r2.sum, expected = 43)!
}

@test
func inline_anon_func_param {
    out! :error?

    r := call_twice_in(
        cb = func {
            in v: int
            out result = v + 1
        },
        a = 1,
        b = 2,
    )
    assert::equal(actual = r.sum, expected = 5)!
}

@test
func inout_accepts_in_requirement {
    out! :error?

    cb := func {
        inout v: int
        out result = v
    }
    r := call_twice_in(cb, a = 3, b = 4)
    assert::equal(actual = r.sum, expected = 7)!
}

@test
func inout_accepts_out_requirement {
    out! :error?

    bump := 5
    cb := func {
        inout v: int
        v = v + bump
    }
    r := call_twice_out(cb, seed = 10)
    assert::equal(actual = r.final, expected = 15)!
}
