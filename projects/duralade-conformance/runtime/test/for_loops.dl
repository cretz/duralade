import duralade.assert
import duralade.test

@test
func break_from_infinite_loop {
    out! :error?

    x := 0
    for {
        x += 1
        if x == 5 {
            break
        }
    }
    assert::equal(actual = x, expected = 5)!
}

@test
func break_labeled {
    out! :error?

    x := 0
    for:outer {
        for {
            x += 1
            break:outer
        }
    }
    assert::equal(actual = x, expected = 1)!
}

@test
func condition_loop_basic {
    out! :error?

    x := 0
    for x < 5 {
        x += 1
    }
    assert::equal(actual = x, expected = 5)!
}

@test
func condition_loop_false_initially {
    out! :error?

    x := 0
    for false {
        x = 99
    }
    assert::equal(actual = x, expected = 0)!
}

@test
func continue_basic {
    out! :error?

    sum := 0
    i := 0
    for i < 10 {
        i += 1
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    # sum of odd numbers 1+3+5+7+9 = 25
    assert::equal(actual = sum, expected = 25)!
}

@test
func continue_labeled {
    out! :error?

    count := 0
    i := 0
    for:outer i < 3 {
        i += 1
        j := 0
        for j < 3 {
            j += 1
            if j == 2 {
                continue:outer
            }
            count += 1
        }
    }
    # Each outer iteration: j=1 increments count, j=2 skips to outer
    assert::equal(actual = count, expected = 3)!
}

@test
func infinite_loop_break {
    out! :error?

    x := 0
    for {
        x += 1
        if x == 3 {
            break
        }
    }
    assert::equal(actual = x, expected = 3)!
}

@test
func nested_break_inner_only {
    out! :error?

    total := 0
    i := 0
    for i < 3 {
        i += 1
        j := 0
        for {
            j += 1
            if j == 2 {
                break
            }
        }
        total += j
    }
    # Each outer iteration: inner breaks at j=2, so total = 2+2+2 = 6
    assert::equal(actual = total, expected = 6)!
}
