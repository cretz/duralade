out entity subscription {
    in email: str
    out send_count = 0

    run {
        out! :error?

        # Infinite loop sending newsletters every 7 days
        for {
            # Sleep for 7 days (can be canceled)
            sleep_result := time::sleep(duration = time::duration_create(days = 7))
            if err := sleep_result.error? {
                if _ := err as cancellation::canceled_error? {
                    # Send farewell email before exiting (uninterruptible)
                    implicitly cancellation::detached()
                    send_farewell(email)!
                }
                return! err
            }

            # Send the newsletter (uninterruptible)
            implicitly cancellation::detached()
            send_newsletter(email)!
            send_count += 1
        }
    }
}

extern send_farewell {
    in email: str
    out! :error?
}

extern send_newsletter {
    in email: str
    out! :error?
}
