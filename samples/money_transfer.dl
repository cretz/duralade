@doc(summary = `Money transfer workflow entity demonstrating error handling and compensation.

Example usage via CLI:

    # Create a money transfer
    duralade entity spawn \
        --entity money_transfer \
        --id xfer1 \
        --in '{"from_account": "acc1", "to_account": "acc2", "amount": 100}' \
        --state xfer1.duralade.json

    # Execute the transfer workflow (will yield waiting for withdraw extern)
    duralade entity tick \
        --state xfer1.duralade.json

    # Complete the withdraw extern
    duralade entity complete-extern \
        --request-event <event_num> \
        --state xfer1.duralade.json

    # Continue execution (will yield waiting for deposit extern)
    duralade entity tick \
        --state xfer1.duralade.json

    # Complete the deposit extern
    duralade entity complete-extern \
        --request-event <event_num> \
        --state xfer1.duralade.json

    # Final tick completes the entity
    duralade entity tick \
        --state xfer1.duralade.json

    # Check entity completion status
    duralade entity describe \
        --state xfer1.duralade.json`)

out entity money_transfer {
    in from_account: str
    in to_account: str
    in amount: int

    run {
        out! :error?

        withdraw(account_id = from_account, amount)!

        deposit_result := deposit(account_id = to_account, amount)
        if err := deposit_result.error? {
            # Deposit failed, return money to source account
            # TODO: how to handle if putting the money back also fails?
            deposit(account_id = from_account, amount)!
            return! err
        }
    }
}

extern deposit {
    in account_id: str
    in amount: int
    out! :error?
}

extern withdraw {
    in account_id: str
    in amount: int
    out! :error?
}
