# Test file for strict import ordering
# Sorting is ASCII: '.' < '0' < 'A' < 'a'

# Basic alphabetical
import b.foo
import a.bar
^^^^^^^^^^^^ @@STRICT: Import 'a.bar' should appear before 'b.foo'

# Second segment tiebreak
import c.baz
import c.bat
^^^^^^^^^^^^ @@STRICT: Import 'c.bat' should appear before 'c.baz'

# Shorter prefix sorts before longer (foo.bar < fooaaa.baz)
import d.fooaaa.qux
import d.foo.quux
^^^^^^^^^^^^^^^^^ @@STRICT: Import 'd.foo.quux' should appear before 'd.fooaaa.qux'
