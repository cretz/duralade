func anon_func_out_type_mismatch {
    needs_supplier(cb = func { out value = "nope" })
                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^ @@ERROR: argument 'cb' type mismatch: expected int, got str
}

func anon_kind_mismatch {
    needs_supplier(cb = data { value = 1 })
