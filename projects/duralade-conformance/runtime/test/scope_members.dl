import duralade.assert
import duralade.test

data box {
    value: int

    out func get {
        out result = value
    }

    out func get_via_closure {
        out result: int
        f := func {
            out value = value
        }
        result = f().value
    }
}

@test
func member_func_closure_reads_construct_field {
    out! :error?

    b := box(value = 99)
    assert::equal(actual = b.get_via_closure().result, expected = 99)!
}

@test
func member_func_reads_construct_field {
    out! :error?

    b := box(value = 42)
    assert::equal(actual = b.get().result, expected = 42)!
}
