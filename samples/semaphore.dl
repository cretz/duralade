@doc(summary = `Counting semaphore for coordination between entities.

Example usage via CLI:

    # Create a semaphore with 3 permits
    duralade entity spawn \
        --entity semaphore \
        --id sem1 \
        --in '{"permits": 3}' \
        --state sem1.duralade.json

    # Try to acquire a permit (non-blocking)
    duralade entity invoke-func-noblock \
        --func acquire_try \
        --state sem1.duralade.json

    # Check remaining permits
    duralade entity view \
        --field permits \
        --state sem1.duralade.json

    # Release a permit
    duralade entity invoke-func-noblock \
        --func release \
        --state sem1.duralade.json`)

out entity semaphore {
    inout permits: int

    out func acquire {
        out! :error?

        wait(permits > 0)!
        permits -= 1
    }

    out noblock func acquire_try {
        out success = false

        if permits > 0 {
            permits -= 1
            success = true
        }
    }

    out noblock func release {
        permits += 1
    }
}
